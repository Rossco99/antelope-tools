# global
STAGE=dev
APP_NAME=eosio-dashboard

# wallet
WALLET_DATA=./wallet_data

# postgres
# -----------------------------------------------------------------------------
# Database and Hasura credentials - DEVELOPMENT VALUES ONLY
# -----------------------------------------------------------------------------
# Real values go in .env.secrets (not committed; create it with `make secrets`),
# which `make <network>` layers over this file. The database URLs and hapi's
# Hasura secret are built from these in docker-compose.yaml.
POSTGRES_USER=antelope
POSTGRES_PASSWORD=antelope-dev-password
POSTGRES_DB=antelope

# hasura
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_ADMIN_SECRET=antelope-dev-admin-secret
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=guest
HASURA_GRAPHQL_ACTION_BASE_URL=http://hapi:9090

# hapi
HAPI_EOS_API_NETWORK_NAME=wax
HAPI_EOS_API_ENDPOINTS=["https://wax.api.eosnation.io","https://wax.greymass.com"]
HAPI_EOS_API_CHAIN_ID=1064487b3cd1a897ce03ae5b6a865651747e2e152090f99c1d19d44e01aea5a4
HAPI_EOS_BASE_ACCOUNT=baseaccount
HAPI_EOS_BASE_ACCOUNT_PASSWORD=PW...
HAPI_EOS_WALLET_URL=http://wallet:8888
HAPI_EOS_BP_JSON_ON_CHAIN=false
HAPI_EOS_BP_JSON_ON_CHAIN_CONTRACT=
HAPI_EOS_BP_JSON_ON_CHAIN_TABLE=
HAPI_EOS_BP_JSON_ON_CHAIN_SCOPE=
HAPI_HASURA_URL=http://hasura:8080/v1/graphql
HAPI_SERVER_PORT=9090
HAPI_SERVER_ADDRESS=hapi
HAPI_SYNC_PRODUCERS_INTERVAL=14400
HAPI_SYNC_PRODUCER_INFO_INTERVAL=1
HAPI_SYNC_EXCHANGE_RATE=86400
HAPI_EOS_EXCHANGE_RATE_API=https://api.coingecko.com/api/v3/simple/price?ids=wax&vs_currencies=usd
HAPI_COINGECKO_API_TOKEN_ID=wax
HAPI_REWARDS_TOKEN=WAX
# -----------------------------------------------------------------------------
# Hyperion - CPU benchmark
# -----------------------------------------------------------------------------
# Hyperion history API nodes (must serve /v2/history, not just /v1/chain), tried in order.
# Used for the CPU benchmark, which reads the eosmechanics::cpu actions run on the network.
# Leave empty to disable the CPU benchmark.
HAPI_EOS_HYPERION_ENDPOINTS=["https://wax.eosphere.io","https://wax.eosusa.io","https://api.waxsweden.org"]
# Show the CPU Benchmark page (needs the Hyperion endpoints above)
REACT_APP_USE_CPU_BENCHMARK=true

# -----------------------------------------------------------------------------
# State History (SHiP) - optional
# -----------------------------------------------------------------------------
# hapi streams every block from a node's state_history_plugin websocket and keeps
# a per-block summary (producer, transactions, CPU/NET usage) in the database.
# The node must run state_history_plugin (state-history-endpoint, usually :8080).
#
# Enables in the webapp:
#   - Dashboard: transactions chart time frame selector and the all-time-high /
#     transactions-per-hour/day stats cards
#   - Block Distribution page
#   - Missed Blocks page (also needs HAPI_EOS_MISSED_BLOCKS_ENABLED=true)
# When enabling, also set REACT_APP_STATE_HISTORY_ENABLED=true, which shows those pages.
# Leave the endpoint empty to disable.

# SHiP websocket, e.g. ws://10.0.0.5:8080
HAPI_EOS_STATE_HISTORY_PLUGIN_ENDPOINT=
# Days of block history kept in the database (older blocks are deleted)
HAPI_EOS_BLOCK_HISTORY_DAYS=90
# Track blocks missed by producers in their scheduled slots
HAPI_EOS_MISSED_BLOCKS_ENABLED=false
# Seconds between transaction statistics updates
HAPI_SYNC_STATS_INTERVAL=60
# Show the history features in the webapp
REACT_APP_STATE_HISTORY_ENABLED=false
HAPI_EOS_GET_FAUCET_ACCOUNT=
HAPI_EOS_FAUCET_ACCOUNT=
HAPI_EOS_FAUCET_ACCOUNT_PASSWORD=
GOOGLE_APPLICATION_CREDENTIALS=
HAPI_RE_CAPTCHA_PROJECT_ID=
HAPI_PUBLIC_RE_CAPTCHA_KEY=
HAPI_CREATE_ACCOUNT_ACTION_NAME=
HAPI_EOSRATE_GET_STATS_URL=
HAPI_EOSRATE_GET_STATS_USER=
HAPI_EOSRATE_GET_STATS_PASSWORD=

#webapp
PORT=3000
REACT_APP_TITLE=WAX Mainnet Network Dashboard
# Landing page linked from the header logo
REACT_APP_LANDING_URL=https://antelope-tools.eosphere.io
# Source repository: footer version badge, bug reports and GitHub links
REACT_APP_REPOSITORY_URL=https://github.com/eosphere/antelope-tools
REACT_APP_VERSION=dev
REACT_APP_NAME=
REACT_APP_DEFAULT_PRODUCER_LOGO=/images/wax.webp
REACT_APP_FOOTER_LINKS='[{"text":"Website","src":"https://www.wax.io/"},{"text":"Block Explorer","src":"https://waxblock.io"},{"text":"GitHub","src":"https://github.com/eosphere/antelope-tools"}]'
REACT_APP_EOS_RATE_LINK=
REACT_APP_USE_REWARDS=true
REACT_APP_USE_VOTES=true
REACT_APP_HASURA_URL=http://localhost:8080/v1/graphql
REACT_APP_EOS_API_NETWORK_NAME=wax-mainnet
REACT_APP_EOS_API_NETWORK_LABEL=WAX Mainnet
REACT_APP_EOS_API_NETWORK_LOGO=/images/wax.webp
REACT_APP_EOS_API_HOSTS=["wax.api.eosnation.io","wax.greymass.com"]
REACT_APP_EOS_API_PORT=443
REACT_APP_EOS_API_PROTOCOL=https
REACT_APP_EOS_CHAIN_ID=1064487b3cd1a897ce03ae5b6a865651747e2e152090f99c1d19d44e01aea5a4
REACT_APP_EOS_USE_BP_JSON_ON_CHAIN=false
REACT_APP_EOS_BP_JSON_ON_CHAIN_CONTRACT=producerjson
REACT_APP_EOS_BP_JSON_ON_CHAIN_TABLE=producerjson
REACT_APP_EOS_BP_JSON_ON_CHAIN_SCOPE=producerjson
REACT_APP_SYNC_TOLERANCE_INTERVAL=180000
REACT_APP_TOKEN_SYMBOL=WAX
REACT_APP_NETWORK_URL=[{"label":"EOS","value":"https://antelope-eos.eosphere.io","mainnet":true,"icon":"eos","order":5},{"label":"XPR Network","value":"https://antelope-xpr.eosphere.io","mainnet":true,"icon":"xpr","order":3},{"label":"WAX","value":"https://antelope-wax.eosphere.io","mainnet":true,"icon":"wax","order":4},{"label":"Telos","value":"https://antelope-telos.eosphere.io","mainnet":true,"icon":"telos","order":1},{"label":"Libre","value":"https://antelope-libre.eosphere.io","mainnet":true,"icon":"libre","order":2},{"label":"Jungle4 Testnet","value":"https://antelope-jungle.eosphere.io","mainnet":false,"icon":"jungle","order":5},{"label":"XPR Network Testnet","value":"https://antelope-xpr-testnet.eosphere.io","mainnet":false,"icon":"xpr","order":3},{"label":"WAX Testnet","value":"https://antelope-wax-testnet.eosphere.io","mainnet":false,"icon":"wax","order":4},{"label":"Telos Testnet","value":"https://antelope-telos-testnet.eosphere.io","mainnet":false,"icon":"telos","order":1},{"label":"Libre Testnet","value":"https://antelope-libre-testnet.eosphere.io","mainnet":false,"icon":"libre","order":2},{"label":"Ultra Testnet","value":"https://antelope-ultra-testnet.eosphere.io","mainnet":false,"pair":"ultra","icon":"ultra","order":6},{"label":"FIO","value":"https://antelope-fio.eosphere.io","mainnet":true,"icon":"fio","order":7},{"label":"FIO Testnet","value":"https://antelope-fio-testnet.eosphere.io","mainnet":false,"icon":"fio","order":7}]
REACT_APP_DISABLED_MENU_ITEMS=["/evm","/evm-rpc-endpoints"]
REACT_APP_BLOCK_EXPLORER_URL={"url":"https://waxblock.io","tx":"/transaction/(transaction)","account":{"url":"/account/","abi":"","actions":""}}
REACT_APP_PUBLIC_RE_CAPTCHA_KEY=key
