# global
STAGE=dev
APP_NAME=antelope-tools

# wallet
WALLET_DATA=./wallet_data

# postgres
POSTGRES_USER=eoscr
POSTGRES_PASSWORD=password
POSTGRES_DB=localdb
POSTGRES_DATA=./db_data

# hasura
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_DATABASE_URL=postgres://eoscr:password@postgres:5432/localdb
HASURA_GRAPHQL_ADMIN_SECRET=myadminsecretkey
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=guest
HASURA_GRAPHQL_ACTION_BASE_URL=http://hapi:9090

# hapi
HAPI_EOS_API_NETWORK_NAME=ultra-testnet
HAPI_EOS_API_ENDPOINTS=["https://test.ultra.eosusa.io"]
HAPI_EOS_API_CHAIN_ID=7fc56be645bb76ab9d747b53089f132dcb7681db06f0852cfa03eaf6f7ac80e9
HAPI_EOS_BASE_ACCOUNT=baseaccount
HAPI_EOS_BASE_ACCOUNT_PASSWORD=PW...
HAPI_EOS_FAUCET_ACCOUNT=1aa2aa3aa4ai
HAPI_EOS_FAUCET_ACCOUNT_PASSWORD=PW...
HAPI_EOS_WALLET_URL=http://wallet:8888
HAPI_EOS_BP_JSON_ON_CHAIN=false
HAPI_EOS_BP_JSON_ON_CHAIN_CONTRACT=
HAPI_EOS_BP_JSON_ON_CHAIN_TABLE=
HAPI_EOS_BP_JSON_ON_CHAIN_SCOPE=
# -----------------------------------------------------------------------------
# Hyperion - CPU benchmark
# -----------------------------------------------------------------------------
# Hyperion history API nodes (must serve /v2/history, not just /v1/chain), tried in order.
# Used for the CPU benchmark, which reads the eosmechanics::cpu actions run on the network.
# Leave empty to disable the CPU benchmark.
HAPI_EOS_HYPERION_ENDPOINTS=
# Show the CPU Benchmark page (needs the Hyperion endpoints above)
REACT_APP_USE_CPU_BENCHMARK=false

# -----------------------------------------------------------------------------
# State History (SHiP) - optional
# -----------------------------------------------------------------------------
# hapi streams every block from a node's state_history_plugin websocket and keeps
# a per-block summary (producer, transactions, CPU/NET usage) in the database.
# The node must run state_history_plugin (state-history-endpoint, usually :8080).
#
# Enables in the webapp:
#   - Dashboard: transactions chart time frame selector and the all-time-high /
#     transactions-per-hour/day stats cards
#   - Block Distribution page
#   - Missed Blocks page (also needs HAPI_EOS_MISSED_BLOCKS_ENABLED=true)
# When enabling, also set REACT_APP_STATE_HISTORY_ENABLED=true, which shows those pages.
# Leave the endpoint empty to disable.

# SHiP websocket, e.g. ws://10.0.0.5:8080
HAPI_EOS_STATE_HISTORY_PLUGIN_ENDPOINT=
# Days of block history kept in the database (older blocks are deleted)
HAPI_EOS_BLOCK_HISTORY_DAYS=90
# Track blocks missed by producers in their scheduled slots
HAPI_EOS_MISSED_BLOCKS_ENABLED=false
# Seconds between transaction statistics updates
HAPI_SYNC_STATS_INTERVAL=60
# Show the history features in the webapp
REACT_APP_STATE_HISTORY_ENABLED=false
HAPI_HASURA_URL=http://hasura:8080/v1/graphql
HAPI_HASURA_ADMIN_SECRET=myadminsecretkey
HAPI_SERVER_PORT=9090
HAPI_SERVER_ADDRESS=hapi
HAPI_DATABASE_URL=postgres://eoscr:password@postgres:5432/localdb
HAPI_SYNC_PRODUCERS_INTERVAL=14400
HAPI_SYNC_PRODUCER_INFO_INTERVAL=1
HAPI_SYNC_EXCHANGE_RATE=86400
HAPI_EOS_EXCHANGE_RATE_API=
HAPI_COINGECKO_API_TOKEN_ID=
HAPI_REWARDS_TOKEN=UOS
GOOGLE_APPLICATION_CREDENTIALS=/app/google-credentials.json
HAPI_RE_CAPTCHA_PROJECT_ID=eosio-dashboard
HAPI_PUBLIC_RE_CAPTCHA_KEY=key
HAPI_CREATE_ACCOUNT_ACTION_NAME=newnonebact
HAPI_EOS_GET_FAUCET_ACCOUNT=

# webapp
PORT=3000
REACT_APP_TITLE=Ultra Testnet Dashboard
# Landing page linked from the header logo
REACT_APP_LANDING_URL=https://antelope-tools.eosphere.io
# Source repository: footer version badge, bug reports and GitHub links
REACT_APP_REPOSITORY_URL=https://github.com/eosphere/antelope-tools
REACT_APP_VERSION=dev
REACT_APP_NAME=
REACT_APP_DEFAULT_PRODUCER_LOGO=/images/ultra.webp
REACT_APP_FOOTER_LINKS=[{"text":"Ultra Website","src":"https://ultra.io/"},{"text":"Ultra Mainnet Explorer","src":"https://explorer.mainnet.ultra.io/"}]
REACT_APP_EOS_RATE_LINK=
REACT_APP_USE_REWARDS=false
REACT_APP_USE_VOTES=false
REACT_APP_HASURA_URL=http://localhost:8080/v1/graphql
REACT_APP_EOS_API_NETWORK_NAME=ultra-testnet
REACT_APP_EOS_API_NETWORK_LABEL=Ultra Testnet
REACT_APP_EOS_API_NETWORK_LOGO=/images/ultra.webp
REACT_APP_EOS_API_HOSTS=["test.ultra.eosusa.io"]
REACT_APP_EOS_API_PORT=443
REACT_APP_EOS_API_PROTOCOL=https
REACT_APP_EOS_CHAIN_ID=7fc56be645bb76ab9d747b53089f132dcb7681db06f0852cfa03eaf6f7ac80e9
REACT_APP_EOS_USE_BP_JSON_ON_CHAIN=false
REACT_APP_EOS_BP_JSON_ON_CHAIN_CONTRACT=producerjson
REACT_APP_EOS_BP_JSON_ON_CHAIN_TABLE=producerjson
REACT_APP_EOS_BP_JSON_ON_CHAIN_SCOPE=producerjson
REACT_APP_SYNC_TOLERANCE_INTERVAL=180000
REACT_APP_TOKEN_SYMBOL=UOS
REACT_APP_NETWORK_URL=[{"label":"EOS","value":"https://eos.antelope.eosphere.io","mainnet":true,"icon":"eos","order":5},{"label":"XPR Network","value":"https://xpr.antelope.eosphere.io","mainnet":true,"icon":"xpr","order":3},{"label":"WAX","value":"https://wax.antelope.eosphere.io","mainnet":true,"icon":"wax","order":4},{"label":"Telos","value":"https://telos.antelope.eosphere.io","mainnet":true,"icon":"telos","order":1},{"label":"Libre","value":"https://libre.antelope.eosphere.io","mainnet":true,"icon":"libre","order":2},{"label":"Jungle4 Testnet","value":"https://jungle.antelope.eosphere.io","mainnet":false,"icon":"jungle","order":5},{"label":"XPR Testnet","value":"https://xpr-testnet.antelope.eosphere.io","mainnet":false,"icon":"xpr","order":3},{"label":"WAX Testnet","value":"https://wax-testnet.antelope.eosphere.io","mainnet":false,"icon":"wax","order":4},{"label":"Telos Testnet","value":"https://telos-testnet.antelope.eosphere.io","mainnet":false,"icon":"telos","order":1},{"label":"Libre Testnet","value":"https://libre-testnet.antelope.eosphere.io","mainnet":false,"icon":"libre","order":2},{"label":"Ultra Testnet","value":"https://ultra-testnet.antelope.eosphere.io","mainnet":false,"pair":"ultra","icon":"ultra","order":6}]
REACT_APP_DISABLED_MENU_ITEMS=["/block-producers","/nodes","/endpoints","/bpjson","/ricardian-contract","/nodes-distribution","/rewards-distribution","/endpoints-stats","/evm","/evm-rpc-endpoints"]
REACT_APP_BLOCK_EXPLORER_URL=
REACT_APP_PUBLIC_RE_CAPTCHA_KEY=key
