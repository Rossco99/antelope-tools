REACT_APP_TOKEN_SYMBOL=EOS
REACT_APP_NETWORK_URL=[{"label":"EOS","value":"https://eos.antelope.eosphere.io","mainnet":true,"icon":"eos","order":5},{"label":"XPR Network","value":"https://xpr.antelope.eosphere.io","mainnet":true,"icon":"xpr","order":3},{"label":"WAX","value":"https://wax.antelope.eosphere.io","mainnet":true,"icon":"wax","order":4},{"label":"Telos","value":"https://telos.antelope.eosphere.io","mainnet":true,"icon":"telos","order":1},{"label":"Libre","value":"https://libre.antelope.eosphere.io","mainnet":true,"icon":"libre","order":2},{"label":"Jungle4 Testnet","value":"https://jungle.antelope.eosphere.io","mainnet":false,"icon":"jungle","order":5},{"label":"XPR Network Testnet","value":"https://xpr-testnet.antelope.eosphere.io","mainnet":false,"icon":"xpr","order":3},{"label":"WAX Testnet","value":"https://wax-testnet.antelope.eosphere.io","mainnet":false,"icon":"wax","order":4},{"label":"Telos Testnet","value":"https://telos-testnet.antelope.eosphere.io","mainnet":false,"icon":"telos","order":1},{"label":"Libre Testnet","value":"https://libre-testnet.antelope.eosphere.io","mainnet":false,"icon":"libre","order":2},{"label":"Ultra Testnet","value":"https://ultra-testnet.antelope.eosphere.io","mainnet":false,"pair":"ultra","icon":"ultra","order":6},{"label":"FIO","value":"https://fio.antelope.eosphere.io","mainnet":true,"icon":"fio","order":7},{"label":"FIO Testnet","value":"https://fio-testnet.antelope.eosphere.io","mainnet":false,"icon":"fio","order":7}]
REACT_APP_DISABLED_MENU_ITEMS=["/evm","/evm-rpc-endpoints"]
REACT_APP_BLOCK_EXPLORER_URL={"url":"https://jungle4.unicove.com/en/jungle4","tx":"/transaction/(transaction)","account":{"url":"/account/","abi":"","actions":""}}
REACT_APP_PUBLIC_RE_CAPTCHA_KEY=key
REACT_APP_EVM_ENDPOINT=https://api.testnet.evm.eosnetwork.com
REACT_APP_EVM_BLOCK_EXPLORER_URL=https://explorer.testnet.evm.eosnetwork.com/block/(block)/transactions
REACT_APP_EVM_ENDPOINTS=["https://api.testnet.evm.eosnetwork.com"]
