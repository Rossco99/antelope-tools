# global
STAGE=dev
APP_NAME=eosio-dashboard

# wallet
WALLET_DATA=./wallet_data

# postgres
POSTGRES_USER=eoscr
POSTGRES_PASSWORD=password
POSTGRES_DB=localdb
POSTGRES_DATA=./db_data

# hasura
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_DATABASE_URL=postgres://eoscr:password@postgres:5432/localdb
HASURA_GRAPHQL_ADMIN_SECRET=myadminsecretkey
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=guest
HASURA_GRAPHQL_ACTION_BASE_URL=http://hapi:9090
HASURA_GRAPHQL_ACTION_EVM_URL=http://hapi-evm:9090

# hapi
HAPI_EOS_API_NETWORK_NAME=telos
HAPI_EOS_API_ENDPOINTS=["https://telos.greymass.com","https://mainnet.telos.net","https://telos.caleos.io","https://telos.eosphere.io"]
HAPI_EOS_API_CHAIN_ID=4667b205c6838ef70ff7988f6e8257e8be0e1284a2f59699054a018f743b1d11
HAPI_EOS_BASE_ACCOUNT=eosmechatero
HAPI_EOS_BASE_ACCOUNT_PASSWORD=PW...
HAPI_EOS_WALLET_URL=http://wallet:8888
HAPI_EOS_BP_JSON_ON_CHAIN=false
HAPI_EOS_BP_JSON_ON_CHAIN_CONTRACT=producerjson
HAPI_EOS_BP_JSON_ON_CHAIN_TABLE=producerjson
HAPI_EOS_BP_JSON_ON_CHAIN_SCOPE=producerjson
HAPI_HASURA_URL=http://hasura:8080/v1/graphql
HAPI_HASURA_ADMIN_SECRET=myadminsecretkey
HAPI_SERVER_PORT=9090
HAPI_SERVER_ADDRESS=hapi
HAPI_DATABASE_URL=postgres://eoscr:password@postgres:5432/localdb
HAPI_SYNC_PRODUCERS_INTERVAL=14400
HAPI_SYNC_PRODUCER_INFO_INTERVAL=1
HAPI_EOS_EXCHANGE_RATE_API=https://api.coingecko.com/api/v3/simple/price?ids=telos&vs_currencies=usd
HAPI_COINGECKO_API_TOKEN_ID=telos
HAPI_REWARDS_TOKEN=TLOS
# -----------------------------------------------------------------------------
# Hyperion - CPU benchmark
# -----------------------------------------------------------------------------
# Hyperion history API nodes (must serve /v2/history, not just /v1/chain), tried in order.
# Used for the CPU benchmark, which reads the eosmechanics::cpu actions run on the network.
# Leave empty to disable the CPU benchmark.
HAPI_EOS_HYPERION_ENDPOINTS=["https://mainnet.telos.net","https://telos.eosusa.io"]
# Show the CPU Benchmark page (needs the Hyperion endpoints above)
REACT_APP_USE_CPU_BENCHMARK=true

# -----------------------------------------------------------------------------
# State History (SHiP) - optional
# -----------------------------------------------------------------------------
# hapi streams every block from a node's state_history_plugin websocket and keeps
# a per-block summary (producer, transactions, CPU/NET usage) in the database.
# The node must run state_history_plugin (state-history-endpoint, usually :8080).
#
# Enables in the webapp:
#   - Dashboard: transactions chart time frame selector and the all-time-high /
#     transactions-per-hour/day stats cards
#   - Block Distribution page
#   - Missed Blocks page (also needs HAPI_EOS_MISSED_BLOCKS_ENABLED=true)
# When enabling, also set REACT_APP_STATE_HISTORY_ENABLED=true, which shows those pages.
# Leave the endpoint empty to disable.

# SHiP websocket, e.g. ws://10.0.0.5:8080
HAPI_EOS_STATE_HISTORY_PLUGIN_ENDPOINT=
# Days of block history kept in the database (older blocks are deleted)
HAPI_EOS_BLOCK_HISTORY_DAYS=90
# Track blocks missed by producers in their scheduled slots
HAPI_EOS_MISSED_BLOCKS_ENABLED=false
# Seconds between transaction statistics updates
HAPI_SYNC_STATS_INTERVAL=60
# Show the history features in the webapp
REACT_APP_STATE_HISTORY_ENABLED=false
HAPI_EOS_GET_FAUCET_ACCOUNT=
HAPI_EOS_FAUCET_ACCOUNT=
HAPI_EOS_FAUCET_ACCOUNT_PASSWORD=
GOOGLE_APPLICATION_CREDENTIALS=
HAPI_RE_CAPTCHA_PROJECT_ID=
HAPI_PUBLIC_RE_CAPTCHA_KEY=
HAPI_CREATE_ACCOUNT_ACTION_NAME=

# hapi-evm
# -----------------------------------------------------------------------------
# EVM dashboard (hapi-evm) - parked
# -----------------------------------------------------------------------------
# Disabled for now: the public EOS EVM RPC endpoints (api[.testnet].evm.eosnetwork.com)
# no longer resolve and the Telos EVM RPCs were not answering. hapi-evm is not started
# by `make start` and the /evm and /evm-rpc-endpoints pages are hidden through
# REACT_APP_DISABLED_MENU_ITEMS. To re-enable: set working RPC endpoints below and in
# REACT_APP_EVM_*, run `make start-hapi-evm` and un-hide the two pages.
HAPI_EVM_SERVER_PORT=9090
HAPI_EVM_SERVER_ADDRESS=hapi-evm
HAPI_EVM_HASURA_URL=http://hasura:8080/v1/graphql
HAPI_EVM_HASURA_ADMIN_SECRET=myadminsecretkey
HAPI_EVM_DATABASE_URL=postgres://eoscr:password@postgres:5432/localdb
HAPI_EVM_ENDPOINT=https://mainnet.telos.net/evm
HAPI_EVM_API_ENDPOINTS=["https://telos.greymass.com","https://mainnet.telos.net","https://telos.caleos.io","https://telos.eosphere.io"]
HAPI_EVM_NETWORK_CHAIN_ID=4667b205c6838ef70ff7988f6e8257e8be0e1284a2f59699054a018f743b1d11
HAPI_EVM_NETWORK=TELOS
HAPI_EVM_EOS_EVM_ACCOUNT=eosio.evm
HAPI_EVM_BLOCK_INTERVAL_SEC=0.5
HAPI_EVM_OLD_BLOCK_INTERVAL_SEC=0.1
HAPI_EVM_ATH_INTERVAL_SEC=900
HAPI_EVM_CLEAN_OLD_BLOCK_INTERVAL_SEC=86400
HAPI_EVM_CLEAN_OLD_TRANSFER_INTERVAL_SEC=86400
HAPI_EVM_KEEP_HISTORY_FOR_YEARS=1
HAPI_EVM_HYPERION_API=https://telos.eosusa.io
HAPI_EVM_HYPERION_START_AT=2021-06-02T00:00:00.000+00:00

